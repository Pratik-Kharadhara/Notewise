# Copy to .env and adjust. All values shown are the defaults.
MAX_FILE_SIZE_MB=100
MAX_CONCURRENT_JOBS=2
MIN_SAMPLES=2048

# Spectral gating (noisereduce)
NR_STATIONARY=false      # true works well for constant fan/AC hum
NR_PROP_DECREASE=0.6     # 0.0-1.0, higher removes more noise (risk: muffled whispers)
NR_CHUNK_SIZE=600000
NR_BLOCK_SECONDS=30      # long files are processed in blocks this long (lower = less RAM)
NR_PAD_SECONDS=2         # context kept around each block to avoid seams
